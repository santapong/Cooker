{
  "name": "cooker-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:local-auth": "playwright test --config=playwright.local-auth.config.ts",
    "test:e2e:environment-editing": "playwright test --config=playwright.environment-editing.config.ts",
    "test:e2e:runtime-logs": "playwright test --config=playwright.runtime-logs.config.ts",
    "test:e2e:perf": "playwright test --project=perf",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:dockerfile-environment": "playwright test --config=playwright.dockerfile-environment.config.ts",
    "test:e2e:source-token": "playwright test --config=playwright.source-token.config.ts"
  },
  "dependencies": {
    "@xyflow/react": "^12.4.0",
    "oidc-client-ts": "^3.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.22.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.9.0",
    "@playwright/test": "^1.62.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "typescript": "~5.5.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
