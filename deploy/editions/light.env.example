# Cooker LIGHT edition — main features, minimal footprint.
# Appended to .env.prod by `make deploy-docker-light` (idempotent).
#
# What runs: pipelines/runs/apps/environments (core), WebSockets, local
# auth, app-health checker. Single replica, in-memory ws/ticket/rate
# backends, NO Redis container, no background job queue or scheduler,
# no metrics/tracing, audit to stdout.
#
# Resource footprint: 2 containers (cooker + postgres), core goroutines
# only (WS hub, app-health, rate-limiter gc).

COOKER_EDITION=light

# Single-replica in-memory backends (no Redis).
COOKER_WS_HUB_BACKEND=memory
COOKER_WS_TICKET_BACKEND=memory
COOKER_RATE_LIMIT_BACKEND=memory

# Background features off.
COOKER_JOBQUEUE_ENABLED=false
COOKER_SCHEDULER_ENABLED=false

# Observability off (health endpoints always on).
COOKER_METRICS_ENABLED=false
COOKER_TRACING_ENABLED=false

# Audit to stdout (no DB table growth, no retention sweeper).
COOKER_AUDIT_DESTINATION=stdout

# Optional integrations off.
COOKER_AI_TRIAGE_ENABLED=false
COOKER_CLOUD_AWS_ENABLED=false
COOKER_CLOUD_GCP_ENABLED=false

# Deployed-app reverse proxy (optional; requires the
# docker-compose.proxy.yml overlay — see INSTALL.md).
#COOKER_PROXY_DOMAIN=127.0.0.1.sslip.io
#COOKER_PROXY_SCHEME=http

# Concurrent-run ceiling: pipeline-run / build / deploy spawns beyond
# this return HTTP 429 instead of overcommitting the host (each
# concurrent build costs ~1 vCPU + 1-2 GB). 0 = unlimited.
#COOKER_MAX_CONCURRENT_RUNS=8
