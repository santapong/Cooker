# Cooker FULL edition — every feature enabled.
# Appended to .env.prod by `make deploy-docker-full` (idempotent).
# Requires the docker-compose.full.yml overlay (adds the Redis sidecar).
#
# What runs on top of LIGHT: Redis-backed ws-hub/ws-ticket/rate-limit
# (multi-replica-ready), durable job queue + worker pool, cron scheduler,
# Prometheus /metrics, OTLP tracing, audit to DB with retention sweep.
#
# Resource footprint: 3 containers (cooker + postgres + redis) plus the
# jobqueue workers, scheduler loop, audit-retention sweeper, and (with a
# k8s deployer) the canary auto-promote sweeper.

COOKER_EDITION=full

# Redis-backed shared backends (the overlay provides redis:6379).
COOKER_WS_HUB_BACKEND=redis
COOKER_WS_TICKET_BACKEND=redis
COOKER_RATE_LIMIT_BACKEND=redis

# Durable async runs + cron triggers.
COOKER_JOBQUEUE_ENABLED=true
COOKER_JOBQUEUE_WORKERS=4
COOKER_SCHEDULER_ENABLED=true

# Observability on. /metrics is served on the main port (8080) unless
# COOKER_METRICS_PORT is set to a dedicated one. Tracing needs an OTLP
# endpoint reachable from the container to be useful.
COOKER_METRICS_ENABLED=true
COOKER_TRACING_ENABLED=true

# Queryable audit trail in Postgres, 90-day retention sweep.
COOKER_AUDIT_DESTINATION=stdout,db
COOKER_AUDIT_DB_RETENTION=2160h

# --- Key-gated integrations: ON once you provide the keys. -----------
# AI failure triage (Anthropic Messages API). Uncomment both to enable.
#COOKER_AI_TRIAGE_ENABLED=true
#ANTHROPIC_API_KEY=

# In-app feedback -> GitHub issues relay.
#COOKER_FEEDBACK_GITHUB_TOKEN=

# Cloud cost/inventory panel (uses the platform credential chain; only
# the locator is required).
#COOKER_CLOUD_AWS_ENABLED=true
#COOKER_CLOUD_AWS_REGION=us-east-1
#COOKER_CLOUD_GCP_ENABLED=true
#COOKER_CLOUD_GCP_PROJECT_ID=
